# ---- AMONG BUG environment (copy to .env) ----
NODE_ENV=development
# Demo fixture & demo logins are only installed when DEMO_MODE=true. Never in production.
DEMO_MODE=true

# API
PORT=4000
HOST=127.0.0.1
# Comma-separated origins allowed to make credentialed requests (web dev server + API-served build)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_TTL_HOURS=14
SESSION_IDLE_MINUTES=180
ADMIN_IDLE_MINUTES=60
# Serve the built web app from the API (production / docker). Leave empty in dev (Vite serves it).
WEB_DIST_DIR=

# Database (npm run db:local gives you this one; docker-compose uses its own)
DATABASE_URL=postgres://postgres:amongbugs@127.0.0.1:54329/among_bugs

# Secrets — REPLACE for any shared/hosted deployment (>= 32 chars, random)
GRADING_SECRET=dev-only-grading-secret-change-me-0123456789
RUNNER_TOKEN=dev-only-runner-token-change-me-0123456789

# scrypt password hashing runs on libuv's thread pool; widen it so login bursts use all cores
UV_THREADPOOL_SIZE=8

# Public base URL used in credential mails and display links
PUBLIC_URL=http://127.0.0.1:4000

# Credential mail. capture = stored locally, shown in the console as "demo mail, not delivered
# externally" (demo default). smtp = SMTP_URL. none = sending is refused (production default
# until SMTP is configured). MAIL_SINK=true when SMTP_URL is a local catcher such as Mailpit.
MAIL_MODE=capture
SMTP_URL=
MAIL_FROM=AMONG BUG <no-reply@among-bug.local>
MAIL_SINK=false

# Code runner
RUNNER_URL=http://127.0.0.1:4100
RUNNER_PORT=4100
RUNNER_MAX_CONCURRENCY=4

# Production bootstrap (npm run bootstrap -w server) — not used in demo mode
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Event Organizer
EVENT_NAME=AMONG BUG
EVENT_DAY1=2026-10-08
EVENT_DAY2=2026-10-09
